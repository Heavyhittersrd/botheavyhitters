# ─── Copia este archivo y llena los valores en Railway ──────────────────────

# 1. Token del bot de Telegram (@BotFather → /newbot)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Credenciales de SignalWire
#    → Entra a tu Space en app.signalwire.com
#    → Ve a API → Credentials
SW_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SW_AUTH_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. URL de tu Space de SignalWire (sin https://)
#    Ejemplo: miempresa.signalwire.com
SW_SPACE_URL=miempresa.signalwire.com

# 4. Tu número de SignalWire (formato E.164)
#    → Phone Numbers → Buy a Number
SW_NUMBER=+12015551234

# 5. URL pública de tu app en Railway (Railway te la da al hacer deploy)
WEBHOOK_BASE_URL=https://tu-app.railway.app

# 6. Tu Chat ID de Telegram (@userinfobot te lo dice)
ADMIN_CHAT_ID=123456789
